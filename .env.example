# Copy to .env and adjust. .env is gitignored.

# PostgreSQL container (docker-compose.yaml)
POSTGRES_DB=meeting_indexer
POSTGRES_USER=meeting_indexer
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5434

# Backend (must point to this machine; the settings refuse anything else)
DATABASE_URL=postgresql://meeting_indexer:change-me@127.0.0.1:5434/meeting_indexer
OLLAMA_HOST=http://127.0.0.1:11434

# Relative paths are resolved against the repository root
DOCS_ROOT=data/documents

LLM_MODEL=qwen3.8:27b-mlx
EMBED_MODEL=bge-m3
